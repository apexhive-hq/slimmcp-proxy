# Copy to .dev.vars ONLY for local wrangler dev testing (never commit .dev.vars).
# In production, provision via `wrangler secret put LICENSE_SIGNING_PRIVATE_JWK`
# using an Ed25519 signing key dedicated ONLY to product license attestation (ZERO crypto custody).
#
# Generate a local test-only Ed25519 JWK pair with:
#   node scripts/gen-dev-keys.mjs
LICENSE_SIGNING_PRIVATE_JWK='{"kty":"OKP","crv":"Ed25519","d":"REPLACE_WITH_DEV_ONLY_ED25519_PRIVATE_KEY","x":"REPLACE_WITH_DEV_ONLY_ED25519_PUBLIC_KEY"}'
LICENSE_SIGNING_PUBLIC_SPKI_B64='REPLACE_WITH_DEV_ONLY_SPKI_BASE64'
