{
  "name": "slimmcp-proxy",
  "version": "1.0.2",
  "mcpName": "io.github.apexhive-hq/slimmcp-proxy",
  "description": "Free MIT progressive-disclosure Meta-MCP proxy supporting stdio, Streamable-HTTP, and SSE upstreams with BM25 discovery, secret redaction, and RBAC policy guardrails.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexhive-hq/slimmcp-proxy.git"
  },
  "homepage": "https://github.com/apexhive-hq/slimmcp-proxy",
  "type": "module",
  "bin": {
    "slimmcp-proxy": "dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "slimmcp.config.example.json",
    "slimmcp.policy.example.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "benchmark": "pnpm run build && node dist/src/cli.js benchmark --config slimmcp.benchmark.config.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
